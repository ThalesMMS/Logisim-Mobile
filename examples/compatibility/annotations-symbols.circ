<?xml version="1.0" encoding="UTF-8"?>
<project source="5.1.0-dev" version="1.0">
  <lib desc="#Base" name="0"/>
  <lib desc="#Wiring" name="1"/>
  <main name="main"/>
  <circuit name="main">
    <comp lib="0" loc="(100,100)" name="Text">
      <a name="text" val="  A &amp; B&#10;linha  "/><a name="font" val="SansSerif bold 18"/>
      <a name="color" val="#12345678"/><a name="halign" val="left"/><a name="valign" val="top"/>
      <a name="mobile-group" val="group-1"/>
    </comp>
    <comp lib="0" loc="(100,200)" name="Image">
      <a name="image" val="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAIAAAABCAYAAAD0In+KAAAAD0lEQVR4nGP4z8DwHwgbABB5A359Y87XAAAAAElFTkSuQmCC"/><a name="width" val="120"/><a name="height" val="80"/>
      <a name="scale" val="cover"/><a name="attribution" val="Author &amp; source"/>
      <a name="mobile-group" val="group-1"/>
    </comp>
    <comp loc="(300,100)" name="child"><a name="facing" val="east"/></comp>
    <comp loc="(400,200)" name="child"><a name="facing" val="north"/></comp>
    <comp loc="(500,300)" name="classicChild"><a name="facing" val="east"/></comp>
  </circuit>
  <circuit name="child">
    <a name="appearance" val="custom"/>
    <appear>
      <rect x="40" y="50" width="30" height="30" fill="none" stroke="#000000" stroke-width="2"/>
      <ellipse cx="85" cy="75" rx="5" ry="5" fill="#ffeecc" stroke="#000000" stroke-width="2"/>
      <circ-port x="50" y="80" dir="in" pin="20,30"/>
      <circ-port x="50" y="50" dir="out" pin="90,30"/>
      <circ-anchor x="50" y="50" facing="north"/>
    </appear>
    <comp lib="1" loc="(20,30)" name="Pin"><a name="facing" val="east"/><a name="width" val="8"/><a name="label" val="A"/></comp>
    <comp lib="1" loc="(90,30)" name="Pin"><a name="facing" val="west"/><a name="width" val="8"/><a name="type" val="output"/><a name="label" val="Y"/></comp>
  </circuit>
  <circuit name="classicChild">
    <a name="appearance" val="classic"/>
    <appear>
      <rect x="40" y="50" width="30" height="30" fill="none" stroke="#000000" stroke-width="2"/>
      <ellipse cx="85" cy="75" rx="5" ry="5" fill="#ffeecc" stroke="#000000" stroke-width="2"/>
      <circ-port x="50" y="80" dir="in" pin="20,30"/>
      <circ-port x="50" y="50" dir="out" pin="90,30"/>
      <circ-anchor x="50" y="50" facing="north"/>
    </appear>
    <comp lib="1" loc="(20,30)" name="Pin"><a name="facing" val="east"/><a name="width" val="8"/><a name="label" val="A"/></comp>
    <comp lib="1" loc="(90,30)" name="Pin"><a name="facing" val="west"/><a name="width" val="8"/><a name="type" val="output"/><a name="label" val="Y"/></comp>
  </circuit>
