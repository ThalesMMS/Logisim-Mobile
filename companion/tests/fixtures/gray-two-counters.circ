<project source="5.1.0" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="jar#external/gray.jar#com.cburch.gray.Components" name="1"/>
  <main name="main"/>
  <circuit name="main">
    <wire from="(100,100)" to="(170,100)"/>
    <wire from="(200,100)" to="(260,100)"/>
    <wire from="(100,180)" to="(170,180)"/>
    <wire from="(200,180)" to="(260,180)"/>
    <comp lib="0" loc="(100,100)" name="Pin"><a name="label" val="A"/></comp>
    <comp lib="0" loc="(100,180)" name="Pin"><a name="label" val="B"/></comp>
    <comp lib="1" loc="(200,100)" name="Gray Counter"/>
    <comp lib="1" loc="(200,180)" name="Gray Counter"/>
    <comp lib="0" loc="(260,100)" name="Pin"><a name="facing" val="west"/><a name="label" val="X"/><a name="type" val="output"/><a name="width" val="4"/></comp>
    <comp lib="0" loc="(260,180)" name="Pin"><a name="facing" val="west"/><a name="label" val="Y"/><a name="type" val="output"/><a name="width" val="4"/></comp>
  </circuit>
</project>
