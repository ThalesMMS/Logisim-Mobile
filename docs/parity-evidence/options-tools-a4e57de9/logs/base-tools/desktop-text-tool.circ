<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="5.1.0dev" version="1.0">
  This file is intended to be loaded by Logisim-evolution v5.1.0dev(https://github.com/logisim-evolution/).

  <lib desc="#Wiring" name="0">
    <tool name="Pin">
      <a name="appearance" val="classic"/>
    </tool>
  </lib>
  <lib desc="#Base" name="1"/>
  <main name="main"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings/>
  <toolbar>
    <tool name="Poke Tool"/>
    <tool name="Text Tool"/>
  </toolbar>
  <circuit name="main">
    <a name="circuit" val="main"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(100,100)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="label" val="clock_enable"/>
    </comp>
    <comp lib="1" loc="(220,160)" name="Text">
      <a name="text">Gate timing
second line</a>
    </comp>
    <comp lib="1" loc="(300,100)" name="Text">
      <a name="text" val="Old note"/>
    </comp>
    <comp lib="1" loc="(300,200)" name="Text">
      <a name="font" val="Serif bold 18"/>
      <a name="halign" val="left"/>
      <a name="text" val="Kept note"/>
    </comp>
  </circuit>
</project>
