<?xml version="1.0" encoding="UTF-8"?>
<project source="5.1.0dev" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Base" name="1"/>
  <toolbar>
    <tool lib="1" name="Poke Tool"/>
    <tool lib="1" name="Text Tool"/>
  </toolbar>
  <main name="main"/>
  <circuit name="main" id="main">
    <comp lib="0" loc="(100,100)" name="Pin" logisim-mobile-id="import-1">
      <a name="label" val="clock_enable"/>
    </comp>
    <comp lib="1" loc="(300,200)" name="Text" logisim-mobile-id="import-3">
      <a name="font" val="Serif bold 18"/>
      <a name="halign" val="left"/>
      <a name="text" val="Kept note"/>
    </comp>
    <comp loc="(220,160)" logisim-mobile-id="c1" name="Text" lib="1">
      <a name="text" val="Gate timing&#10;second line"/>
    </comp>
  </circuit>
</project>
