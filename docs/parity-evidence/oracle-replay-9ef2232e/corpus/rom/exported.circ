<?xml version="1.0" encoding="UTF-8"?>
<project source="3.8.0" version="1.0">
  <lib name="0" desc="#Wiring"/>
  <lib name="1" desc="#Memory"/>
  <main name="RomLookup"/>
  <circuit name="RomLookup" id="RomLookup">
    <comp lib="0" name="Pin" loc="(100,150)" logisim-mobile-id="import-1">
      <a name="label" val="ADDR"/>
      <a name="width" val="2"/>
      <a name="appearance" val="classic"/>
    </comp>
    <comp lib="1" name="ROM" loc="(200,140)" logisim-mobile-id="import-2">
      <a name="appearance" val="classic"/>
      <a name="addrWidth" val="2"/>
      <a name="dataWidth" val="8"/>
      <a name="contents">addr/data: 2 8&#10;12 34 56 78&#10;</a>
    </comp>
    <comp lib="0" name="Pin" loc="(520,200)" logisim-mobile-id="import-3">
      <a name="label" val="Dados"/>
      <a name="width" val="8"/>
      <a name="type" val="output"/>
      <a name="appearance" val="classic"/>
    </comp>
    <wire from="(100,150)" to="(200,150)"/>
    <wire from="(440,200)" to="(520,200)"/>
  </circuit>
</project>
