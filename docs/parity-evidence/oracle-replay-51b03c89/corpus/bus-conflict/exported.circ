<project source="3.8.0" version="1.0">
  <lib name="0" desc="#Wiring"/>
  <main name="BusConflict"/>
  <circuit name="BusConflict" id="BusConflict">
    <comp lib="0" name="Pin" loc="(100,100)" logisim-mobile-id="import-1">
      <a name="label" val="A"/>
      <a name="width" val="4"/>
      <a name="appearance" val="classic"/>
    </comp>
    <comp lib="0" name="Pin" loc="(100,200)" logisim-mobile-id="import-2">
      <a name="label" val="B"/>
      <a name="width" val="4"/>
      <a name="appearance" val="classic"/>
    </comp>
    <comp lib="0" name="Pin" loc="(300,100)" logisim-mobile-id="import-3">
      <a name="label" val="Y"/>
      <a name="width" val="4"/>
      <a name="type" val="output"/>
      <a name="appearance" val="classic"/>
    </comp>
    <wire from="(100,100)" to="(200,100)"/>
    <wire from="(100,200)" to="(200,200)"/>
    <wire from="(200,200)" to="(200,100)"/>
    <wire from="(200,100)" to="(300,100)"/>
