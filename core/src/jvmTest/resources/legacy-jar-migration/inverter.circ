<?xml version="1.0" encoding="UTF-8"?>
<project source="2.7.1" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="jar#inverter.jar#org.example.InverterLibrary" name="1">
    <tool name="Bus Inverter"/>
  </lib>
  <main name="main"/>
  <circuit name="main">
    <wire from="(100,100)" to="(180,100)"/>
    <wire from="(200,100)" to="(260,100)"/>
    <comp lib="0" loc="(100,100)" name="Pin">
      <a name="label" val="A"/><a name="width" val="4"/>
    </comp>
    <comp lib="1" loc="(200,100)" name="Bus Inverter"/>
    <comp lib="0" loc="(260,100)" name="Pin">
      <a name="facing" val="west"/><a name="label" val="Y"/><a name="output" val="true"/><a name="width" val="4"/>
    </comp>
  </circuit>
</project>
