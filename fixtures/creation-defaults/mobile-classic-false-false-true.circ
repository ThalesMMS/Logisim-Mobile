<?xml version="1.0" encoding="UTF-8"?>
<project source="3.8.0" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Memory" name="5"/>
  <lib desc="#Base" name="9"/>
  <mappings>
    <tool lib="9" name="Poke Tool" map="Button2"/>
    <tool lib="9" name="Menu Tool" map="Button3"/>
    <tool lib="9" name="Menu Tool" map="Ctrl Button1"/>
  </mappings>
  <toolbar>
    <tool lib="9" name="Poke Tool"/>
    <tool lib="9" name="Edit Tool"/>
    <tool lib="9" name="Wiring Tool"/>
    <tool lib="9" name="Text Tool"/>
    <tool lib="9" name="Image"/>
    <sep/>
    <tool lib="0" name="Pin"/>
    <tool lib="0" name="Pin">
      <a name="facing" val="west"/>
      <a name="type" val="output"/>
    </tool>
    <sep/>
    <tool lib="1" name="NOT Gate"/>
    <tool lib="1" name="AND Gate"/>
    <tool lib="1" name="OR Gate"/>
    <tool lib="1" name="XOR Gate"/>
    <tool lib="1" name="NAND Gate"/>
    <tool lib="1" name="NOR Gate"/>
    <sep/>
    <tool lib="5" name="D Flip-Flop"/>
    <tool lib="5" name="Register"/>
  </toolbar>
  <options>
    <a name="simlimit" val="256"/>
    <a name="memoryStartupUnknown" val="false"/>
    <a name="gateUndefined" val="ignore"/>
    <a name="tickFrequencyHz" val="1.0"/>
    <a name="autoPropagating" val="true"/>
  </options>
  <main name="main"/>
  <circuit name="main" id="main">
    <a name="appearance" val="classic"/>
    <a name="circuitnamedboxfixedsize" val="false"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp loc="(300,200)" logisim-mobile-id="c1" name="D Flip-Flop" lib="5">
      <a name="appearance" val="classic"/>
      <a name="trigger" val="rising"/>
      <a name="label" val=""/>
    </comp>
    <comp loc="(100,200)" logisim-mobile-id="c2" name="Pin" lib="0">
      <a name="facing" val="east"/>
      <a name="type" val="input"/>
      <a name="width" val="1"/>
      <a name="appearance" val="classic"/>
      <a name="behavior" val="simple"/>
      <a name="label" val=""/>
      <a name="labelloc" val="west"/>
      <a name="labelfont" val="SansSerif bold 16"/>
      <a name="radix" val="2"/>
      <a name="initial" val="0x0"/>
    </comp>
  </circuit>
  <circuit name="sub" id="circuit-1">
    <a name="appearance" val="classic"/>
    <a name="circuitnamedboxfixedsize" val="false"/>
  </circuit>
</project>
