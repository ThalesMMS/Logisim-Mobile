<?xml version="1.0" encoding="UTF-8"?>
<project source="3.8.0" version="1.0">
  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="5"/>
  <lib desc="#I/O" name="6"/>
  <lib desc="#TTL" name="7"/>
  <lib desc="#TCL" name="8"/>
  <lib desc="#Base" name="9"/>
  <lib desc="#BFH-Praktika" name="10"/>
  <lib desc="#Input/Output-Extra" name="11"/>
  <lib desc="#Soc" name="12"/>
  <mappings>
    <tool lib="9" name="Poke Tool" map="Button2"/>
    <tool lib="9" name="Menu Tool" map="Button3"/>
    <tool lib="9" name="Menu Tool" map="Ctrl Button1"/>
  </mappings>
  <toolbar>
    <tool lib="9" name="Poke Tool"/>
    <tool lib="9" name="Edit Tool"/>
    <tool lib="9" name="Wiring Tool"/>
    <tool lib="9" name="Text Tool"/>
    <tool lib="9" name="Image"/>
    <sep/>
    <tool lib="0" name="Pin"/>
    <tool lib="0" name="Pin">
      <a name="facing" val="west"/>
      <a name="type" val="output"/>
    </tool>
    <sep/>
    <tool lib="1" name="NOT Gate"/>
    <tool lib="1" name="AND Gate"/>
    <tool lib="1" name="OR Gate"/>
    <tool lib="1" name="XOR Gate"/>
    <tool lib="1" name="NAND Gate"/>
    <tool lib="1" name="NOR Gate"/>
    <sep/>
    <tool lib="5" name="D Flip-Flop"/>
    <tool lib="5" name="Register"/>
  </toolbar>
  <options>
    <a name="simlimit" val="256"/>
    <a name="memoryStartupUnknown" val="false"/>
    <a name="gateUndefined" val="ignore"/>
    <a name="tickFrequencyHz" val="1.0"/>
    <a name="autoPropagating" val="true"/>
  </options>
  <main name="Minha_primeira_porta_AND"/>
  <circuit name="Minha_primeira_porta_AND" id="Minha_primeira_porta_AND">
    <a name="simulationFrequency" val="1.0"/>
    <comp loc="(100,100)" logisim-mobile-id="a" name="Pin" lib="0">
      <a name="facing" val="east"/>
      <a name="type" val="input"/>
      <a name="width" val="1"/>
      <a name="appearance" val="classic"/>
      <a name="label" val="A"/>
    </comp>
    <comp loc="(100,200)" logisim-mobile-id="b" name="Pin" lib="0">
      <a name="facing" val="east"/>
      <a name="type" val="input"/>
      <a name="width" val="1"/>
      <a name="appearance" val="classic"/>
      <a name="label" val="B"/>
    </comp>
    <comp loc="(300,150)" logisim-mobile-id="and" name="AND Gate" lib="1">
      <a name="facing" val="east"/>
      <a name="width" val="1"/>
      <a name="size" val="50"/>
      <a name="inputs" val="2"/>
      <a name="out" val="01"/>
      <a name="label" val="AND"/>
    </comp>
    <comp loc="(420,150)" logisim-mobile-id="out" name="Pin" lib="0">
      <a name="facing" val="west"/>
      <a name="type" val="output"/>
      <a name="width" val="1"/>
      <a name="appearance" val="classic"/>
      <a name="label" val="Y"/>
    </comp>
    <wire from="(100,100)" to="(200,100)"/>
    <wire from="(200,100)" to="(200,130)"/>
    <wire from="(200,130)" to="(250,130)"/>
    <wire from="(100,200)" to="(220,200)"/>
    <wire from="(220,200)" to="(220,170)"/>
    <wire from="(220,170)" to="(250,170)"/>
    <wire from="(300,150)" to="(420,150)"/>
  </circuit>
</project>
