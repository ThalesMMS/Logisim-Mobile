<?xml version="1.0" encoding="UTF-8"?>
<project source="5.1.0" version="1.0" qualification-source="cell53">
  <lib name="w" desc="#Wiring"/>
  <main name="Cell53" marker="cell-main53"/>
  <circuit name="Cell53" id="circuit-cell53">
    <a name="appearance" val="custom"/>
    <appear><rect x="60" y="80" width="80" height="40"/><circ-anchor facing="east" x="100" y="100"/><circ-port dir="in" pin="0,0" x="60" y="100"/><circ-port dir="out" pin="140,0" x="140" y="100"/></appear>
    <comp lib="w" name="Pin" loc="(0,0)" logisim-mobile-id="cell-in53"><a name="width" val="8"/><a name="label" val="CELL_IN53"/></comp>
    <comp lib="w" name="Pin" loc="(140,0)" logisim-mobile-id="cell-out53"><a name="type" val="output"/><a name="facing" val="west"/><a name="width" val="8"/><a name="label" val="CELL_OUT53"/></comp>
    <wire from="(0,0)" to="(140,0)"/>
  </circuit>
</project>
